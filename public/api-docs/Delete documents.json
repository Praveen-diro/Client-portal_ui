{
  "openapi": "3.0.1",
  "info": {
    "title": "Diro - Internet Original Documents",
    "description": "<p id='no-code-integration'>Intergration API of document verification button for businesses.</p>",
    "version": "1.1",
    "termsOfService": "https://diro.io/term-condition/",
    "contact": {
      "name": "Diro API Support",
      "url": "https://diro.io/contact-form/",
      "email": "support@diro.io"
    },
    "license": {
      "name": "Diro API license v.2.0",
      "url": "https://diro.io/term-condition/"
    }
  },
  "servers": [
    {
      "url": "https://api.dirolabs.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "${environment.varificationSwaggerLinkBeta}/delete-document": {
      "post": {
        "tags": ["Delete documents"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "To delete PDF, MHTML, session document.",
        "description": "<h2>Delete PDF, MHTML, session documents </h2>\n<p>Use this API to delete PDF, Mhtml, session document..</p>\n",
        "operationId": "deletedocument",
        "requestBody": {
          "description": "Request to delete PDF, Mhtml, session document.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeletedocumentRequest"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/DeletedocumentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedocumentResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Docid is wrong or empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocIdWrongResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/DocIdWrongResponse"
                }
              }
            }
          },
          "400_1": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDeleted"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDeleted"
                }
              }
            }
          },
          "400_2": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocIdEmpty"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/DocIdEmpty"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidRequest"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/InvalidRequest"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DeletedocumentRequest": {
        "type": "object",
        "required": ["docid"],
        "properties": {
          "docid": {
            "type": "string",
            "description": "Session ID of the document to be deleted",
            "example": "IN-Ab3E"
          }
        }
      },
      "DeletedocumentResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Success"
          },
          "message": {
            "type": "string",
            "example": "Document deleted successfully"
          }
        }
      },
      "DocIdWrongResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Error"
          },
          "message": {
            "type": "string",
            "example": "Document ID is wrong"
          }
        }
      },
      "DocumentDeleted": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Error"
          },
          "message": {
            "type": "string",
            "example": "Document already deleted"
          }
        }
      },
      "DocIdEmpty": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Error"
          },
          "message": {
            "type": "string",
            "example": "Document ID is empty"
          }
        }
      },
      "InvalidRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "Error"
          },
          "message": {
            "type": "string",
            "example": "Unauthorized request"
          }
        }
      }
    }
  }
}
