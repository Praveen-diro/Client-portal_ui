{
  "swagger": "2.0",
  "info": {
    "title": "Diro - Internet Original Documents",
    "description": "<p id='no-code-integration'>Intergration API of document verification button for businesses.</p>",
    "version": "1.1",
    "termsOfService": "https://diro.io/term-condition/",
    "contact": {
      "name": "Diro API Support",
      "url": "https://diro.io/contact-form/",
      "email": "support@diro.io"
    },
    "license": {
      "name": "Diro API license v.2.0",
      "url": "https://diro.io/term-condition/"
    }
  },
  "host": "api.dirolabs.com",
  "schemes": ["https"],
  "paths": {
    "/beta/delete-document": {
      "post": {
        "tags": ["Delete documents"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "To delete PDF, MHTML, session document.",
        "description": "<h2>Delete PDF, MHTML, session documents</h2>\n<p>Use this API to delete PDF, Mhtml, session document.</p>\n",
        "operationId": "deletedocument",
        "consumes": ["application/json", "application/xml"],
        "produces": ["application/json", "application/xml"],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Request to delete PDF, Mhtml, session document.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/DeletedocumentRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful",
            "schema": {
              "$ref": "#/definitions/DeletedocumentResponse"
            }
          },
          "400": {
            "description": "Docid is wrong or empty",
            "schema": {
              "$ref": "#/definitions/DocIdWrongResponse"
            }
          },
          "422": {
            "description": "Document already deleted",
            "schema": {
              "$ref": "#/definitions/DocumentDeleted"
            }
          },
          "404": {
            "description": "Document ID is empty",
            "schema": {
              "$ref": "#/definitions/DocIdEmpty"
            }
          },
          "401": {
            "description": "Unauthorized Request",
            "schema": {
              "$ref": "#/definitions/InvalidRequest"
            }
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "bearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "definitions": {
    "DeletedocumentRequest": {
      "type": "object",
      "required": ["docid"],
      "properties": {
        "docid": {
          "type": "string", 
          "description": "unique id for document submitted",
          "example": "IN-123TXyT"
        },
        "session": {
          "type": "boolean",
          "example": "false"
        }
      },
      "xml": {
        "name": "PdftojsonRequest"
      }
    },
    "DeletedocumentResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "example": "Success"
        },
        "message": {
          "type": "string",
          "example": "Document deleted successfully"
        }
      }
    },
    "DocIdWrongResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "boolean",
          "example": true
        },
        "message": {
          "type": "string", 
          "example": "sessionid does not exist"
        }
      }
    },
    "DocumentDeleted": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "example": "Document already deleted"
        },
        "error": {
          "type": "boolean", 
          "example": true
        }
      }
    },
    "DocIdEmpty": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "example": "session id can't be null or empty"
        }
      }
    },
    "InvalidRequest": {
      "type": "object", 
      "properties": {
        "timestamp": {
          "type": "string",
          "example": "2024-07-01T10:02:27.547+0000"
        },
        "status": {
          "type": "number",
          "example": 401
        },
        "error": {
          "type": "string",
          "example": "Unauthorized"
        },
        "message": {
          "type": "string",
          "example": "Jwt token is expired pls generate new token!"
        },
        "path": {
          "type": "string",
          "example": "/Zuul-1.0/HI-2.0/pdf/pdftojson"
        }
      }
    }
  }
}
