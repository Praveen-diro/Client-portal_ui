      "InvalidToken": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "example": "2024-07-01T10:02:27.547+0000"
          },
          "status": {
            "type": "number", 
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "Unauthorized"
          },
          "message": {
            "type": "string",
            "example": "Jwt token is expired pls generate new token!"
          },
          "path": {
            "type": "string",
            "example": "/Zuul-1.0/HI-2.0/pdf/pdftojson"
          }
        }
      },
      "InvalidSessionIdResponse": {
        "type": "object",
