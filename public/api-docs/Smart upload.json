          "error": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Feedback_Response5": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "example": "File is password protected"
          },
          "error": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Feedback_Response6": {
        "type": "object",
        "properties": {
          "msg": {
            "type": "string",
            "example": "File is corrupted"
          },
          "error": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "MissingAPIKeyResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string", 
            "example": "Missing API key in headers!"
          }
        }
      },
      "APIKeyInvalid_Response": {
        "type": "object",
