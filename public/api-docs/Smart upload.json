          "message": {
            "type": "string",
            "example": "File size should not exceed 50MB!"
          }
        }
      },
      "InternalServerError_Response": {
        "type": "object",
        "properties": {
          "error": {
            "type": "boolean", 
            "example": true
          },
          "message": {
            "type": "string",
            "example": "An internal server error occurred."
          }
        }
      },
      "InternalServerError_Response1": {
        "type": "object",
